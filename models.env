# models.env — Model IDs and validated MAX_MODEL_LEN for DGX Spark GB10 (128GB unified memory)
# Source this file or reference it in scripts.
#
# MAX_MODEL_LEN is the maximum safe context length on this hardware.
# Values derived from: 128GB total - model weights - OS/framework overhead = KV cache budget.
# Gemma 3 models require --language-model-only flag (multimodal architecture, text-only serving).
# Llama and Qwen are FP8 quantized — gated models, require HF_TOKEN.

GEMMA_1B="google/gemma-3-1b-it"
GEMMA_1B_MAX_LEN=32768        # hard limit from model architecture (max_position_embeddings)

GEMMA_4B="google/gemma-3-4b-it"
GEMMA_4B_MAX_LEN=131072       # fits comfortably within 128GB unified memory

GEMMA_12B="google/gemma-3-12b-it"
GEMMA_12B_MAX_LEN=131072      # fits comfortably within 128GB unified memory

GEMMA_27B="google/gemma-3-27b-it"
GEMMA_27B_MAX_LEN=65536       # 51.45GB weights — 131072 causes GPU allocator OOM (NV_ERR_NO_MEMORY)

LLAMA_70B="neuralmagic/Meta-Llama-3.1-70B-Instruct-FP8"
LLAMA_70B_MAX_LEN=32768       # FP8 quantized, gated model — requires HF_TOKEN

QWEN_72B="neuralmagic/Qwen2.5-72B-Instruct-FP8"
QWEN_72B_MAX_LEN=32768        # FP8 quantized, gated model — requires HF_TOKEN
